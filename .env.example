# Copy to .env.local for local dev, and set the same vars on the Vercel project.
# Only NEXT_PUBLIC_DEMO_URL is inlined into the browser bundle; the rest are
# read on the server at request time. Vercel still applies an env-var change
# only to NEW deployments — after changing any of these, redeploy.
# Real values live in Vercel only; this repo is public, so keep them out of it.

# Resend — sends the demo-request notification to the founders.
# Every lead is recorded twice: this email AND a row in Notion (below). The
# visitor only sees an error if BOTH fail; one failing alone is logged in
# Vercel → Logs. Never fail open on lead capture.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Must be an address on a Resend-verified domain. envolv.org was verified in
# Resend on 2026-08-26, so noreply@envolv.org works.
RESEND_FROM_EMAIL=noreply@envolv.org

# Comma-separated. Every demo request is sent to all of these.
# List all three co-founders. Do NOT use the Yakima clinic's admin addresses —
# those are the clinic's coordinators, and routing inbound sales leads to a
# client would be a bad day.
DEMO_NOTIFY_EMAILS=founder-one@example.com,founder-two@example.com,founder-three@example.com

# Base URL of the demo APP (medvolunteer built with NEXT_PUBLIC_DEMO_MODE=1).
# The /demo page sends visitors to <this>/api/demo/enter?as=admin|volunteer,
# and its QR code is rendered from it at build time — redeploy after changing.
NEXT_PUBLIC_DEMO_URL=https://envolv-demo.vercel.app

# Notion — saves every demo request as a row in the "Website Leads" database
# (Envolv workspace → Marketing and Sales Hub).
# NOTION_TOKEN is the secret of an internal integration ("envolv-www leads",
# notion.so/profile/integrations) with Insert + Read content. The integration
# must also be added to the database: ⋯ → Connections → envolv-www leads.
# Mark NOTION_TOKEN as Sensitive in Vercel.
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxx
# The database's data source id (not the page id). Not a secret.
NOTION_LEADS_DATA_SOURCE_ID=00000000-0000-0000-0000-000000000000

# support@envolv.org relay (app/api/inbound/route.ts). The webhook's signing
# secret (Resend → Webhooks) and a FULL-ACCESS Resend key to read received mail.
RESEND_WEBHOOK_SECRET=
RESEND_INBOX_API_KEY=
# Optional; defaults to DEMO_NOTIFY_EMAILS.
SUPPORT_FORWARD_TO=
