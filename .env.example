# Copy to .env.local for local dev, and set the same vars on the Vercel project.
# Only NEXT_PUBLIC_DEMO_URL is inlined into the browser bundle; the rest are
# read on the server at request time. Vercel still applies an env-var change
# only to NEW deployments — after changing any of these, redeploy.
# Real values live in Vercel only; this repo is public, so keep them out of it.

# Resend — sends the demo-request notification.
# Without it the form still validates but returns a "not configured" error
# instead of silently pretending to have sent. Never fail open on lead capture.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Must be an address on a Resend-verified domain. envolv.org was verified in
# Resend on 2026-08-26, so noreply@envolv.org works.
RESEND_FROM_EMAIL=noreply@envolv.org

# Comma-separated. Every demo request is sent to all of these.
# List all three co-founders. Do NOT use the Yakima clinic's admin addresses —
# those are the clinic's coordinators, and routing inbound sales leads to a
# client would be a bad day.
DEMO_NOTIFY_EMAILS=founder-one@example.com,founder-two@example.com,founder-three@example.com

# Live product demo the "See it live" button points at.
NEXT_PUBLIC_DEMO_URL=https://envolv-demo.vercel.app
